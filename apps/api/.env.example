# The running API connects as the restricted role created by `npm run db:app-role` (see db/ops/app_role.sql).
DATABASE_URL=postgres://mpizza_app:APP_ROLE_PASSWORD@localhost:5432/mpizza
# Owner credentials: used only by migrations, the demo seed, staff-account management and tests.
MIGRATION_DATABASE_URL=postgres://OWNER:OWNER_PASSWORD@localhost:5432/mpizza
# Read by `npm run db:app-role` only (at least 24 characters); keep it equal to the password in DATABASE_URL.
APP_DB_PASSWORD=generate-a-random-string-of-at-least-24-characters
PORT=3000
HOST=127.0.0.1
BRAND_NAME=M Pizza
BRAND_NAME_AR=إم بيتزا
OTP_SECRET=generate-a-random-string-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:8080
# TRUST_PROXY_HOPS=1   # required when HOST is not loopback (run behind a TLS proxy)

# Paymob Egypt: the current recommended flow is Intention API + Unified Checkout.
# Test/live mode is selected by the Paymob credentials and Integration IDs, not by a different base URL.
PAYMOB_MODE=intention
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=sk_test_replace_me
PAYMOB_PUBLIC_KEY=pk_test_replace_me
# Comma-separated Test Integration IDs for enabled methods (card, wallet, BNPL, etc.).
PAYMOB_PAYMENT_METHOD_IDS=123456,123457
PAYMOB_HMAC_SECRET=replace-with-test-hmac-secret
# Must be a public HTTPS endpoint reachable by Paymob; localhost will not receive callbacks.
PAYMOB_NOTIFICATION_URL=https://api.example.com/payments/webhook/paymob
# Optional UX redirect; payment state is still confirmed only by the signed webhook.
PAYMOB_REDIRECTION_URL=https://app.example.com/payment-result

# Legacy Classic Accept fallback, only when PAYMOB_MODE=classic:
# PAYMOB_API_KEY=replace-with-test-api-key
# PAYMOB_INTEGRATION_ID=123456
# PAYMOB_IFRAME_ID=123456
